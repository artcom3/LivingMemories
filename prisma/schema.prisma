generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id                  String             @id
  name                String
  email               String             @unique
  emailVerified       Boolean            @default(false)
  image               String?
  createdAt           DateTime           @default(now())
  updatedAt           DateTime           @default(now()) @updatedAt
  sessions            Session[]
  accounts            Account[]
  memberships         Membership[]
  invitationsCreated  Invitation[]       @relation("InvitationCreator")
  invitationsAccepted Invitation[]       @relation("InvitationAcceptor")
  personProfiles      PersonProfile[]
  memoryCollections   MemoryCollection[]
  memories            Memory[]
  storyPreparations   StoryPreparation[]
  musicPreparations   MusicPreparation[]
  creations           Creation[]

  @@map("user")
}

model Session {
  id        String   @id
  expiresAt DateTime
  token     String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  ipAddress String?
  userAgent String?
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("session")
}

model Account {
  id                    String    @id
  accountId             String
  providerId            String
  userId                String
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  @@index([userId])
  @@map("account")
}

model Verification {
  id         String   @id
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @default(now()) @updatedAt

  @@index([identifier])
  @@map("verification")
}

enum FamilyRole {
  ADMIN
  CONTRIBUTOR
  READER
}

enum MembershipStatus {
  ACTIVE
  REVOKED
}

enum InvitationStatus {
  PENDING
  ACCEPTED
  REVOKED
}

enum DeliveryStatus {
  PENDING
  SENT
  FAILED
}

model Family {
  id                String             @id @default(cuid())
  name              String
  activatedAt       DateTime?
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt
  memberships       Membership[]
  invitations       Invitation[]
  profiles          PersonProfile[]
  collections       MemoryCollection[]
  memories          Memory[]
  storyPreparations StoryPreparation[]
  musicPreparations MusicPreparation[]
  creations         Creation[]

  @@map("family")
}

model Membership {
  id               String           @id @default(cuid())
  familyId         String
  userId           String
  role             FamilyRole
  status           MembershipStatus @default(ACTIVE)
  adultConfirmedAt DateTime
  revokedAt        DateTime?
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt
  family           Family           @relation(fields: [familyId], references: [id], onDelete: Cascade)
  user             User             @relation(fields: [userId], references: [id], onDelete: Restrict)

  @@unique([familyId, userId])
  @@index([userId, status])
  @@index([familyId, status, role])
  @@map("membership")
}

model Invitation {
  id             String           @id @default(cuid())
  familyId       String
  email          String
  role           FamilyRole
  tokenHash      String           @unique
  status         InvitationStatus @default(PENDING)
  deliveryStatus DeliveryStatus   @default(PENDING)
  expiresAt      DateTime
  acceptedAt     DateTime?
  acceptedById   String?
  createdById    String?
  createdAt      DateTime         @default(now())
  family         Family           @relation(fields: [familyId], references: [id], onDelete: Cascade)
  createdBy      User?            @relation("InvitationCreator", fields: [createdById], references: [id], onDelete: SetNull)
  acceptedBy     User?            @relation("InvitationAcceptor", fields: [acceptedById], references: [id], onDelete: SetNull)

  @@index([familyId, email, status])
  @@map("invitation")
}

model PersonProfile {
  id           String    @id @default(cuid())
  familyId     String
  name         String
  relationship String?
  biography    String?
  voiceId      String?
  voiceStatus  String    @default("NONE")
  voiceOperation String?
  voiceStartedAt DateTime?
  voiceLanguage String?
  voiceSampleKey String?
  voicePreviewKey String?
  voiceConsentAt DateTime?
  voiceConsentById String?
  createdById  String
  archivedAt   DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  family       Family    @relation(fields: [familyId], references: [id], onDelete: Cascade)
  createdBy    User      @relation(fields: [createdById], references: [id], onDelete: Restrict)
  memories     Memory[]

  @@index([familyId, archivedAt])
  @@map("person_profile")
}

enum MemorySourceType {
  PHOTO
  VIDEO
  AUDIO
  TEXT
}

model MemoryCollection {
  id          String   @id @default(cuid())
  familyId    String
  createdById String
  name        String
  description String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  family      Family   @relation(fields: [familyId], references: [id], onDelete: Cascade)
  createdBy   User     @relation(fields: [createdById], references: [id], onDelete: Restrict)
  memories    Memory[]

  @@index([familyId, createdById])
  @@map("memory_collection")
}

model Memory {
  id                String             @id @default(cuid())
  familyId          String
  createdById       String
  narratorProfileId String?
  collectionId      String?
  title             String
  description       String?            @db.Text
  trashedAt         DateTime?
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt
  family            Family             @relation(fields: [familyId], references: [id], onDelete: Cascade)
  createdBy         User               @relation(fields: [createdById], references: [id], onDelete: Restrict)
  narrator          PersonProfile?     @relation(fields: [narratorProfileId], references: [id], onDelete: Restrict)
  collection        MemoryCollection?  @relation(fields: [collectionId], references: [id], onDelete: SetNull)
  sources           MemorySource[]
  storyPreparations StoryPreparation[]

  @@index([familyId, createdById, trashedAt])
  @@map("memory")
}

model MemorySource {
  id                 String                   @id @default(cuid())
  memoryId           String
  type               MemorySourceType
  originalName       String
  originalText       String?                  @db.Text
  fileKey            String?                  @unique
  mimeType           String?
  byteSize           Int?
  contextDescription String?                  @db.Text
  peopleContext      String?
  locationContext    String?
  dateContext        String?
  emotionContext     String?
  withdrawnAt        DateTime?
  createdAt          DateTime                 @default(now())
  updatedAt          DateTime                 @updatedAt
  memory             Memory                   @relation(fields: [memoryId], references: [id], onDelete: Cascade)
  preparations       StoryPreparationSource[]
  musicPreparations  MusicPreparationSource[]
  creations          CreationSource[]
  storyAnalysis      SourceStoryAnalysis?
  episodes           MemoryEpisode[]

  @@index([memoryId, withdrawnAt])
  @@map("memory_source")
}

model StoryPreparation {
  musicMoment Json?
  id                String                   @id @default(cuid())
  familyId          String
  createdById       String
  memoryId          String
  title             String
  language          String                   @default("es")
  readerProfile     String                   @default("AGE_5_8")
  pages             Int                      @default(6)
  instructions      String?                  @db.Text
  genericCharacters Boolean                  @default(false)
  narrativeStyle    String                   @default("CHILDREN")
  visualStyle       String                   @default("WATERCOLOR")
  narrate           Boolean                  @default(true)
  illustrate        Boolean                  @default(false)
  creations         Creation[]
  createdAt         DateTime                 @default(now())
  updatedAt         DateTime                 @updatedAt
  family            Family                   @relation(fields: [familyId], references: [id], onDelete: Cascade)
  createdBy         User                     @relation(fields: [createdById], references: [id], onDelete: Restrict)
  memory            Memory                   @relation(fields: [memoryId], references: [id], onDelete: Restrict)
  sources           StoryPreparationSource[]

  @@index([familyId, createdById])
  @@map("story_preparation")
  episodeId String?
  episode MemoryEpisode? @relation(fields: [episodeId], references: [id], onDelete: Restrict)

}

model StoryPreparationSource {
  preparationId String
  sourceId      String
  preparation   StoryPreparation @relation(fields: [preparationId], references: [id], onDelete: Cascade)
  source        MemorySource     @relation(fields: [sourceId], references: [id], onDelete: Restrict)

  @@id([preparationId, sourceId])
  @@map("story_preparation_source")
}

model MusicPreparation {
  id              String                   @id @default(cuid())
  familyId        String
  createdById     String
  title           String
  language        String                   @default("es")
  style           String                   @default("ACOUSTIC")
  instrumental    Boolean                  @default(true)
  durationSeconds Int                      @default(30)
  instructions    String?                  @db.Text
  createdAt       DateTime                 @default(now())
  updatedAt       DateTime                 @updatedAt
  family          Family                   @relation(fields: [familyId], references: [id], onDelete: Cascade)
  createdBy       User                     @relation(fields: [createdById], references: [id], onDelete: Restrict)
  sources         MusicPreparationSource[]
  creations       Creation[]

  @@index([familyId, createdById])
  @@map("music_preparation")
  episodeId String?
  episode MemoryEpisode? @relation(fields: [episodeId], references: [id], onDelete: Restrict)

}

model MusicPreparationSource {
  preparationId String
  sourceId      String
  preparation   MusicPreparation @relation(fields: [preparationId], references: [id], onDelete: Cascade)
  source        MemorySource     @relation(fields: [sourceId], references: [id], onDelete: Restrict)

  @@id([preparationId, sourceId])
  @@map("music_preparation_source")
}

enum CreationKind {
  STORY
  MUSIC
}

enum CreationStatus {
  QUEUED
  ANALYZING
  REVIEW
  RENDER_QUEUED
  RENDERING
  READY
  FAILED
}

model Creation {
  locales            StoryLocale[]
  id                 String            @id @default(cuid())
  familyId           String
  createdById        String
  kind               CreationKind
  status             CreationStatus    @default(QUEUED)
  storyPreparationId String?
  musicPreparationId String?
  settings           Json
  evidence           Json?
  draft              Json?
  artifacts          Json              @default("[]")
  reservedCents      Int               @default(500)
  errorMessage       String?
  reviewedAt         DateTime?
  createdAt          DateTime          @default(now())
  updatedAt          DateTime          @updatedAt
  family             Family            @relation(fields: [familyId], references: [id], onDelete: Cascade)
  createdBy          User              @relation(fields: [createdById], references: [id], onDelete: Restrict)
  storyPreparation   StoryPreparation? @relation(fields: [storyPreparationId], references: [id], onDelete: Cascade)
  musicPreparation   MusicPreparation? @relation(fields: [musicPreparationId], references: [id], onDelete: Cascade)
  sources            CreationSource[]

  @@index([familyId, createdById, createdAt])
  @@index([status])
  @@map("creation")
  episodeId String?
  episode MemoryEpisode? @relation(fields: [episodeId], references: [id], onDelete: Restrict)

}

model StoryLocale {
  id           String         @id @default(cuid())
  creationId   String
  createdById  String
  language     String
  status       CreationStatus @default(QUEUED)
  baseDraft    Json
  settings     Json
  draft        Json?
  artifacts    Json           @default("[]")
  attempts     Int            @default(0)
  errorMessage String?
  reviewedAt   DateTime?
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt
  creation     Creation       @relation(fields: [creationId], references: [id], onDelete: Cascade)

  @@unique([creationId, language])
  @@index([status])
  @@map("story_locale")
}

model CreationSource {
  creationId String
  sourceId   String
  creation   Creation     @relation(fields: [creationId], references: [id], onDelete: Cascade)
  source     MemorySource @relation(fields: [sourceId], references: [id], onDelete: Restrict)

  @@id([creationId, sourceId])
  @@map("creation_source")
}

// Private contextual assistant. Access is always resolved against live family resources.
model AssistantDocument {
  embeddingModel String @default("openai:text-embedding-3-small")
  id String @id @default(cuid())
  sourceId String @unique
  familyId String
  ownerId String
  sourceVersion DateTime
  memoryVersion DateTime
  version String
  status String @default("PENDING")
  category String @default("TESTIMONY")
  derived Json?
  errorCode String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  passages AssistantPassage[]
  @@index([familyId, status])
  @@map("assistant_document")
}
model AssistantPassage {
  id String @id @default(cuid())
  documentId String
  text String @db.Text
  locator Json
  embedding Unsupported("vector(1536)")?
  document AssistantDocument @relation(fields: [documentId], references: [id], onDelete: Cascade)
  fragments AssistantFragment[]
  @@index([documentId])
  @@map("assistant_passage")
}
model AssistantFragment {
  id String @id @default(cuid())
  passageId String @unique
  approvedById String
  approvedAt DateTime @default(now())
  revokedAt DateTime?
  passage AssistantPassage @relation(fields: [passageId], references: [id], onDelete: Cascade)
  @@map("assistant_fragment")
}
model AssistantConversation {
  id String @id @default(cuid())
  familyId String
  userId String
  context Json
  contextRevision Int @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  turns AssistantTurn[]
  voices AssistantVoiceSession[]
  @@index([familyId, userId, updatedAt])
  @@map("assistant_conversation")
}
model AssistantTurn {
  id String @id @default(cuid())
  conversationId String
  requestKey String
  question String @db.Text
  answer String? @db.Text
  status String @default("PENDING")
  context Json
  contextRevision Int
  destinations Json @default("[]")
  model String @default("gpt-6-luna")
  instructionsVersion String @default("assistant-v1")
  createdAt DateTime @default(now())
  conversation AssistantConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  citations AssistantCitation[]
  @@unique([conversationId, requestKey])
  @@map("assistant_turn")
}
model AssistantCitation {
  id String @id @default(cuid())
  turnId String
  passageId String
  sourceVersion String
  turn AssistantTurn @relation(fields: [turnId], references: [id], onDelete: Cascade)
  @@index([passageId])
  @@map("assistant_citation")
}
model AssistantVoiceSession {
  id String @id @default(cuid())
  conversationId String
  tokenHash String @unique
  providerConversationId String? @unique
  reservationId String @unique
  status String @default("CONNECTING")
  expiresAt DateTime
  lastActivityAt DateTime @default(now())
  createdAt DateTime @default(now())
  conversation AssistantConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  @@map("assistant_voice_session")
}
model UsageReservation {
  id String @id @default(cuid())
  operationKey String @unique
  familyId String
  userId String
  capability String
  reservedCents Int
  actualCents Int?
  status String @default("RESERVED")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  @@index([createdAt, familyId, userId])
  @@map("usage_reservation")
}

model SourceStoryAnalysis {
  id String @id @default(cuid())
  sourceId String @unique
  requestedById String
  sourceVersion DateTime
  status String @default("PENDING")
  transcript String? @db.Text
  timestamps Json?
  errorCode String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  source MemorySource @relation(fields: [sourceId], references: [id], onDelete: Cascade)
  @@index([status])
  @@map("source_story_analysis")
}
model MemoryEpisode {
  id String @id @default(cuid())
  sourceId String
  sourceVersion DateTime
  title String
  summary String @db.Text
  excerpt String @db.Text
  startOffset Int
  endOffset Int
  audioStart Float?
  audioEnd Float?
  status String @default("SUGGESTED")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  source MemorySource @relation(fields: [sourceId], references: [id], onDelete: Cascade)
  books StoryPreparation[]
  songs MusicPreparation[]
  creations Creation[]
  @@unique([sourceId, sourceVersion, startOffset, endOffset])
  @@map("memory_episode")
}
