# Development PostgreSQL (Docker Compose).
POSTGRES_USER=livingmemories
POSTGRES_PASSWORD=livingmemories_dev
POSTGRES_DB=livingmemories
POSTGRES_PORT=5433

# Keep these credentials and port in sync with the PostgreSQL variables above.
DATABASE_URL=postgresql://livingmemories:livingmemories_dev@127.0.0.1:5433/livingmemories?schema=public

# Generate a secret with: openssl rand -base64 32
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3000

# Complete local Docker stack. pnpm docker:env generates missing secrets.
APP_PORT=8081
DOCKER_APP_URL=http://localhost:8081
S3_PORT=9000
MINIO_CONSOLE_PORT=9001
MINIO_ROOT_USER=livingmemories_admin
MINIO_ROOT_PASSWORD=
S3_ENDPOINT=http://127.0.0.1:9000
S3_REGION=us-east-1
S3_BUCKET=livingmemories
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_FORCE_PATH_STYLE=true
MAILPIT_PORT=8025
SMTP_HOST=127.0.0.1
SMTP_PORT=1025
MAIL_FROM=LivingMemories <app@livingmemories.test>
WORKER_HEALTH_PORT=3010
WORKER_HEALTH_URL=http://127.0.0.1:3010

# Optional external APIs. They are not required for local infrastructure startup.
# Put real keys in .env.local; Compose loads it without adding it to images/Git.
OPENAI_API_KEY=
# Gemini is selected only when OPENAI_API_KEY is empty.
GEMINI_API_KEY=
# interactions or generate_content (useful for accounts where that endpoint works)
GEMINI_API_MODE=interactions
GEMINI_MODEL_TEXT=gemini-3.8-flash
GEMINI_MODEL_IMAGE=gemini-nano-banana-2.1
ELEVENLABS_API_KEY=
OPENAI_MODEL_TEXT=gpt-6.1-sol
OPENAI_MODEL_ASSISTANT=gpt-6-luna
# Assistant falls back to Gemini only when OPENAI_API_KEY is empty.
GEMINI_MODEL_ASSISTANT=gemini-3.8-flash
OPENAI_MODEL_EMBEDDING=text-embedding-3-small
OPENAI_MODEL_IMAGE=gpt-image-2.5-flare
ELEVENLABS_STT_MODEL=scribe_v2
ELEVENLABS_TTS_MODEL=eleven_v4
# Gemini adds subtle voice tags to v4 narration; original story text stays intact.
ELEVENLABS_AUTO_TAGS=true
GEMINI_MODEL_NARRATION_TAGS=gemini-3.5-flash-lite
ELEVENLABS_MUSIC_MODEL=music_v2_5
ELEVENLABS_VOICE_ID_ES=
ELEVENLABS_VOICE_ID_EN=

# Contextual assistant: enable text and voice independently.
ASSISTANT_TEXT_ENABLED=false
ASSISTANT_VOICE_ENABLED=false
ASSISTANT_PUBLIC_URL=
ASSISTANT_VOICE_AGENT_ID=
ASSISTANT_VOICE_SECRET=
ASSISTANT_VOICE_CENTS_PER_MINUTE=
ASSISTANT_VOICE_RATE_VERIFIED=false
ASSISTANT_VOICE_RETENTION_VERIFIED=false
# Workspace secret ID used only by the provisioning script; its value is ASSISTANT_VOICE_SECRET.
ASSISTANT_VOICE_PROVIDER_SECRET_ID=

# Optional override for detecting episodes in original text/transcripts.
GEMINI_MODEL_STORY_DETECTION=gemini-3.5-flash-lite

# Optional internal reservation limits for book/song generations (off during development).
CREATION_RESERVATION_LIMITS_ENABLED=false
