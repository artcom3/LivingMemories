# Development PostgreSQL (Docker Compose).
POSTGRES_USER=livingmemories
POSTGRES_PASSWORD=livingmemories_dev
POSTGRES_DB=livingmemories
POSTGRES_PORT=5433

# Keep these credentials and port in sync with the PostgreSQL variables above.
DATABASE_URL=postgresql://livingmemories:livingmemories_dev@localhost:5433/livingmemories?schema=public

# Generate a secret with: openssl rand -base64 32
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3000

# Complete local Docker stack. pnpm docker:env generates missing secrets.
APP_PORT=8081
DOCKER_APP_URL=http://localhost:8081
S3_PORT=9000
MINIO_CONSOLE_PORT=9001
MINIO_ROOT_USER=livingmemories_admin
MINIO_ROOT_PASSWORD=
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_BUCKET=livingmemories
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_FORCE_PATH_STYLE=true
MAILPIT_PORT=8025
SMTP_HOST=localhost
SMTP_PORT=1025
MAIL_FROM=LivingMemories <app@livingmemories.test>
WORKER_HEALTH_PORT=3010
WORKER_HEALTH_URL=http://localhost:3010

# Optional external APIs. They are not required for local infrastructure startup.
# Put real keys in .env.local; Compose loads it without adding it to images/Git.
OPENAI_API_KEY=
ELEVENLABS_API_KEY=
OPENAI_MODEL_TEXT=gpt-6.1-sol
OPENAI_MODEL_ASSISTANT=gpt-6-luna
OPENAI_MODEL_EMBEDDING=text-embedding-3-small
OPENAI_MODEL_IMAGE=gpt-image-2.5-flare
ELEVENLABS_STT_MODEL=scribe_v2
ELEVENLABS_TTS_MODEL=eleven_multilingual_v2
ELEVENLABS_MUSIC_MODEL=music_v2
ELEVENLABS_VOICE_ID_ES=
ELEVENLABS_VOICE_ID_EN=
