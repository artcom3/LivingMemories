{
  "name": "livingmemories",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "next dev",
    "build": "prisma generate && next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "postinstall": "prisma generate",
    "db:up": "node scripts/docker/up.mjs --db-only",
    "db:down": "docker compose -f docker-compose.dev.yml stop db",
    "db:logs": "docker compose -f docker-compose.dev.yml logs -f db",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:status": "prisma migrate status",
    "db:studio": "prisma studio",
    "auth:generate": "auth generate --config ./src/lib/auth.ts --output ./prisma/schema.prisma",
    "auth:check": "auth check schema --config ./src/lib/auth.ts",
    "docker:env": "node scripts/docker/setup-env.mjs",
    "docker:up": "node scripts/docker/up.mjs",
    "docker:down": "docker compose -f docker-compose.dev.yml down",
    "docker:logs": "docker compose -f docker-compose.dev.yml logs -f",
    "docker:check": "docker compose -f docker-compose.dev.yml exec -T worker node --conditions=react-server --import=tsx scripts/docker/check.mts",
    "docker:check:apis": "docker compose -f docker-compose.dev.yml exec -T worker node --conditions=react-server --import=tsx scripts/docker/check-external.mts",
    "worker": "node --env-file=.env --env-file-if-exists=.env.local --conditions=react-server --import=tsx src/worker/index.ts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "3.1149.0",
    "@better-auth/prisma-adapter": "1.7.7",
    "@elevenlabs/elevenlabs-js": "2.71.0",
    "@next/env": "16.4.0",
    "@prisma/adapter-pg": "7.10.0",
    "@prisma/client": "7.10.0",
    "better-auth": "1.7.7",
    "next": "16.4.0",
    "nodemailer": "10.0.16",
    "pg": "8.23.1",
    "pg-boss": "12.37.1",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "server-only": "0.0.1"
  },
  "devDependencies": {
    "@tailwindcss/turbopack": "^4",
    "@types/node": "^20",
    "@types/nodemailer": "8.0.2",
    "@types/pg": "8.23.1",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "auth": "1.7.7",
    "eslint": "^9",
    "eslint-config-next": "16.4.0",
    "prisma": "7.10.0",
    "tailwindcss": "^4",
    "tsx": "4.23.15",
    "typescript": "^5"
  },
  "packageManager": "pnpm@12.9.1"
}
